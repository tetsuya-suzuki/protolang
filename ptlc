#!/usr/bin/env bash
set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ ! -d "$SCRIPT_DIR/.venv" ]; then
  echo "error: virtual environment not found" >&2
  echo "run ./setup first" >&2
  exit 1
fi

. "$SCRIPT_DIR/.venv/bin/activate"

export PYTHONPATH="$SCRIPT_DIR/src"

python -m protolang.main "$@"
